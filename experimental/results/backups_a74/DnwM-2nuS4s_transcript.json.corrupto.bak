      "end": "00:05:36.284",
      "source": "DnwM-2nuS4s.es.vtt"
    },
    {
      "text": "eh la la\nel<00:05:36.394><c> escenario</c><00:05:36.994><c> que</c><00:05:37.194><c> lo</c><00:05:37.194><c> seguimos</c><00:05:37.594><c> teniendo</c>\n00:05:37.884 --> 00:05:37.894 align:start position:0%",
