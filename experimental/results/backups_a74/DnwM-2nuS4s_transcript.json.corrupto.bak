{
  "video_id": "DnwM-2nuS4s",
  "segments": [
    {
      "text": "Saludos<00:00:00.600><c> cordiales.</c><00:00:01.200><c> Bienvenida,</c>\n00:00:02.190 --> 00:00:02.200 align:start position:0%",
      "start": "00:00:00.300",
      "end": "00:00:02.190",
      "source": "DnwM-2nuS4s.es.vtt"
    },
