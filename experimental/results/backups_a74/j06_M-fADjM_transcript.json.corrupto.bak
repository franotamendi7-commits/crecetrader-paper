      "end": "00:01:54.790",
      "source": "j06_M-fADjM.es.vtt"
    },
    {
      "text": "pues ayer se levantó el el mercado con\nese<00:01:54.900><c> ruido,</c>\n00:01:55.990 --> 00:01:56.000 align:start position:0%",
      "start": "00:01:54.800",
      "end": "00:01:55.990",
      "source": "j06_M-fADjM.es.vtt"
    },
