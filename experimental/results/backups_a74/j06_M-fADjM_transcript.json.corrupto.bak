      "text": "ese ruido,\nestuvo<00:01:56.800><c> bastante</c><00:01:57.300><c> alcista,</c>\n00:01:58.890 --> 00:01:58.900 align:start position:0%",
      "start": "00:01:56.000",
      "end": "00:01:58.890",
      "source": "j06_M-fADjM.es.vtt"
    },
