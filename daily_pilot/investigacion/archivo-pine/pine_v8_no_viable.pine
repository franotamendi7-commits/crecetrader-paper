//@version=5
// ============================================================================
//  CreceTrader — Niveles por TEMPORALIDAD (C05)  ·  v8
//
//  El metodo trabaja en 3 marcos: MACRO = semanal, MICRO = diario y 4h.
//  Este indicador dibuja el tramo y los niveles de CADA temporalidad en el
//  mismo grafico, con un color distinto, para no confundirse:
//
//    1S  gris     (macro)
//    1D  azul     (micro)
//    4H ("240" en Pine) violeta (micro)
//
//  Reglas validadas contra las capturas reales de Francisco (BNB, 2026-11-20):
//    · Tramo = maximo mas alto -> piso mas bajo posterior
//    · El fibo se tira AL REVES: 0 = minimo, 1 = maximo
//    · Extensiones (1 .. 3) quedan ARRIBA del maximo
//    · Retrocesos: 0,382 / 0,5 / 0,61 / 0,786
//
//  PAPER ONLY — dibuja, no opera. No hay ninguna funcion de orden.
//  Usa request.security (multi-temporal). Si algo falla, apagar el TF en entradas.
// ============================================================================
indicator("CreceTrader — Niveles por temporalidad [C05]", overlay=true,
     max_lines_count=500, dynamic_requests=true)

// ---------------- entradas ----------------
g1 = "1 · Marco"
ver1W = input.bool(true, "1S  semanal (macro)", group=g1)
ver1D = input.bool(true, "1D  diario",          group=g1)
ver4H = input.bool(true, "4H  4 horas",         group=g1)
velasMarco = input.int(12, "Velas del ciclo (12 ~ 3 meses)", minval=3, maxval=250, group=g1)

g2 = "2 · Niveles"
mostrarRetro = input.bool(true, "Retrocesos",  group=g2)
mostrarExt   = input.bool(true, "Extensiones", group=g2)
etiquetas    = input.bool(true, "Etiquetas",   group=g2)

g4 = "4 · Diagnostico"
mostrarDiag = input.bool(false, "Mostrar tramo de cada TF", group=g4)

// ---------------- colores ----------------
cRetro = color.new(color.teal, 0)
cExt   = color.new(color.red,  0)
cW = color.new(color.gray,    30)
cD = color.new(color.blue,    30)
cH = color.new(color.fuchsia, 30)

// ---------------- utilidades ----------------
retrocesos  = array.from(0.382, 0.50, 0.61, 0.786)
extensiones = array.from(1.0, 1.25, 1.50, 1.75, 2.0, 3.0)

// Tramo de una temporalidad: maximo y minimo de las ultimas N velas de ese marco.
calcularTramo(string tf) =>
    [h, l] = request.security(syminfo.tickerid, tf, [high, low],
                             gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float mx = ta.highest(h, velasMarco)
    float mn = ta.lowest(l, velasMarco)
    [mn, mx]

drawNivel(float precio, string txt, color col) =>
    if not na(precio) and etiquetas and barstate.islast
        line.new(bar_index - 1, precio, bar_index, precio, color=col, extend=extend.right)
        label.new(bar_index, precio, txt, style=label.style_label_left,
                  color=color.new(col, 70), textcolor=color.white, size=size.small)

dibujarMarco(string tf, bool visible, color col) =>
    if visible and barstate.islast
        [mn, mx] = calcularTramo(tf)
        if not na(mn) and not na(mx) and mx > mn
            float rg = mx - mn
            line.new(bar_index, mn, bar_index, mx, color=col, style=line.style_dashed)
            if mostrarRetro
                for _r in retrocesos
                    drawNivel(mn + rg * _r, tf + " " + str.tostring(_r, "#.##"), cRetro)
            if mostrarExt
                for _e in extensiones
                    drawNivel(mn + rg * _e, tf + " " + str.tostring(_e, "#.##"), cExt)

// ---------------- dibujo ----------------
dibujarMarco("1W", ver1W, cW)
dibujarMarco("1D", ver1D, cD)
dibujarMarco("240", ver4H, cH)

// ---------------- diagnostico ----------------
if mostrarDiag and barstate.islast
    [mnW, mxW] = calcularTramo("1W")
    [mnD, mxD] = calcularTramo("1D")
    [mnH, mxH] = calcularTramo("240")
    lbl = "1S  " + str.tostring(mnW, "#.##") + " -> " + str.tostring(mxW, "#.##") + "\n" +
          "1D  " + str.tostring(mnD, "#.##") + " -> " + str.tostring(mxD, "#.##") + "\n" +
          "4H  " + str.tostring(mnH, "#.##") + " -> " + str.tostring(mxH, "#.##")
    label.new(bar_index, high, lbl, style=label.style_label_down,
              color=color.new(color.yellow, 20), textcolor=color.black, size=size.small)
