  <section class="panel" id="panel-planes"></section>
  <section class="panel" id="panel-manager"></section>
  <section class="panel" id="panel-seguimiento"></section>
  <section class="panel" id="panel-decision"></section>
</main>

<footer id="pie"></footer>

