<title>YouTube Analyst — Dashboard (PAPER_ONLY)</title>
<style>
  :root{
    --bg:#0d1117; --panel:#161b22; --panel2:#1b2130; --border:#2b3342; --border2:#364052;
    --text:#e6edf3; --muted:#9aa7b4; --faint:#6e7681;
    --accent:#4f8cff; --ok:#3fb950; --warn:#f0a020; --bad:#f85149;
    --purple:#a371f7; --cyan:#39c5cf; --orange:#db6d28;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--bg); color:var(--text);
    font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .top{border-bottom:1px solid var(--border);background:linear-gradient(180deg,#11161f,#0d1117);position:sticky;top:0;z-index:20}
  .top-inner{max-width:1400px;margin:0 auto;padding:16px 20px 0}
  .title-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
  h1{font-size:20px;margin:0;font-weight:700;letter-spacing:.2px}
  .fuente{margin:6px 0 0;color:var(--muted);font-size:13px}
  .tag{font-size:11px;font-weight:700;letter-spacing:.4px;padding:3px 8px;border-radius:20px;border:1px solid var(--border2);text-transform:uppercase}
  .tag-paper{color:#0d1117;background:var(--warn);border-color:var(--warn)}
  .tag-offline{color:var(--muted);background:var(--panel2)}
  .avisos{display:grid;gap:8px;margin:14px 0 0}
  .aviso{padding:9px 12px;border-radius:8px;font-size:13px;border:1px solid}
  .aviso-rojo{background:rgba(248,81,73,.10);border-color:rgba(248,81,73,.45);color:#ffb4ae}
  .aviso-amarillo{background:rgba(240,160,32,.10);border-color:rgba(240,160,32,.45);color:#ffd48a}
  .aviso-azul{background:rgba(79,140,255,.10);border-color:rgba(79,140,255,.45);color:#b9d2ff}
  .aviso b{color:inherit}
  .tabs{display:flex;gap:6px;margin-top:16px;flex-wrap:wrap}
  .tab{background:transparent;border:1px solid transparent;border-bottom:none;color:var(--muted);
       padding:10px 14px;border-radius:8px 8px 0 0;cursor:pointer;font-size:13px;font-weight:600;letter-spacing:.3px}
  .tab:hover{color:var(--text);background:var(--panel)}
  .tab.active{color:var(--text);background:var(--panel);border-color:var(--border);position:relative;top:1px}
  main{max-width:1400px;margin:0 auto;padding:20px}
  .panel{display:none}
  .panel.active{display:block}
  .section-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:12px;margin-bottom:6px}
  .section-title{font-size:17px;font-weight:700;margin:0}
  .section-sub{color:var(--muted);font-size:13px}
  .section-note{color:var(--faint);font-size:12px;margin:2px 0 16px;max-width:1100px}
  .legend{display:flex;flex-wrap:wrap;gap:14px;padding:10px 12px;background:var(--panel);border:1px solid var(--border);border-radius:8px;margin-bottom:16px;font-size:12px;color:var(--muted)}
  .legend b{color:var(--text)}
  .table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:10px;background:var(--panel)}
  table{border-collapse:collapse;width:100%;min-width:980px}
  th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--border);vertical-align:top;font-size:13px}
  th{background:var(--panel2);color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover{background:rgba(79,140,255,.05)}
  .cell-main{font-weight:600}
  .cell-sub{margin-top:4px}
  .cell-note{margin-top:4px;color:var(--muted);font-size:12px}
  .num{font-variant-numeric:tabular-nums}
  .missing{color:var(--faint);font-style:italic;font-weight:400}
  .muted{color:var(--muted)}
  .small{font-size:12px}
  .proc{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.3px;padding:1px 6px;border-radius:4px;border:1px solid transparent;white-space:nowrap;vertical-align:middle}
  .prov-A{color:#7ee787;background:rgba(63,185,80,.12);border-color:rgba(63,185,80,.4)}
  .prov-B{color:#79c0ff;background:rgba(79,140,255,.12);border-color:rgba(79,140,255,.4)}
  .prov-C{color:#d2a8ff;background:rgba(163,113,247,.12);border-color:rgba(163,113,247,.4)}
  .prov-D{color:#ffa657;background:rgba(219,109,40,.14);border-color:rgba(219,109,40,.45)}
  .prov-none{color:var(--faint);background:transparent;border-color:var(--border2)}
  .badge{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.3px;padding:3px 8px;border-radius:6px;border:1px solid;white-space:nowrap}
  .badge-c-nivel{color:#9aa4b2;border-color:#3a4250;background:rgba(154,164,178,.08)}
  .badge-c-zona{color:#79c0ff;border-color:rgba(79,140,255,.5);background:rgba(79,140,255,.10)}
  .badge-c-cond{color:#ffd48a;border-color:rgba(240,160,32,.5);background:rgba(240,160,32,.10)}
  .badge-c-plan{color:#7ee787;border-color:rgba(63,185,80,.5);background:rgba(63,185,80,.10)}
  .badge-c-planinc{color:#ffd48a;border-color:rgba(240,160,32,.5);background:rgba(240,160,32,.10)}
  .badge-c-oport{color:#d2a8ff;border-color:rgba(163,113,247,.5);background:rgba(163,113,247,.10)}
  .badge-c-valid{color:#7ee787;border-color:rgba(63,185,80,.5);background:rgba(63,185,80,.10)}
  .badge-c-noope,.badge-c-desc{color:#ff9b95;border-color:rgba(248,81,73,.5);background:rgba(248,81,73,.10)}
  .badge-c-indet{color:#e3b341;border-color:rgba(227,179,65,.5);background:rgba(227,179,65,.10)}
  .badge-v-apto{color:#7ee787;border-color:rgba(63,185,80,.5);background:rgba(63,185,80,.10)}
  .badge-v-esperar{color:#ffd48a;border-color:rgba(240,160,32,.5);background:rgba(240,160,32,.10)}
  .badge-v-falta{color:#ff9b95;border-color:rgba(248,81,73,.5);background:rgba(248,81,73,.10)}
  .badge-v-riesgo{color:#ffa657;border-color:rgba(219,109,40,.5);background:rgba(219,109,40,.10)}
  .badge-v-noope{color:#ff9b95;border-color:rgba(248,81,73,.5);background:rgba(248,81,73,.10)}
  .badge-v-invalid{color:#9aa4b2;border-color:#3a4250;background:rgba(154,164,178,.08)}
  .badge-estado{color:#79c0ff;border-color:rgba(79,140,255,.5);background:rgba(79,140,255,.10)}
  .badge-demo{color:#0d1117;background:var(--warn);border-color:var(--warn)}
  .cards{display:grid;gap:14px}
  .card{background:var(--panel);border:1px solid var(--border);border-left:4px solid var(--faint);border-radius:10px;overflow:hidden}
  .card.c-nivel{border-left-color:#9aa4b2}
  .card.c-zona{border-left-color:var(--accent)}
  .card.c-cond{border-left-color:var(--warn)}
  .card.c-plan{border-left-color:var(--ok)}
  .card.c-planinc{border-left-color:var(--warn)}
  .card.c-oport{border-left-color:var(--purple)}
  .card.c-valid{border-left-color:var(--ok)}
  .card.c-noope,.card.c-desc{border-left-color:var(--bad)}
  .card.c-indet{border-left-color:#e3b341}
  .card-head{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;background:var(--panel2);flex-wrap:wrap;align-items:center}
  .card-id{font-weight:700;font-size:14px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  .card-sub{color:var(--muted);font-size:12px;margin-top:3px}
  .card-badges{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
  .card-body{padding:12px 14px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
  .field{background:var(--panel2);border:1px solid var(--border);border-radius:8px;padding:9px 11px}
  .field label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--faint);margin-bottom:5px;font-weight:700}
  .field-val{font-size:13px;word-break:break-word}
  .field-val .proc{margin-left:4px}
  .lista{margin:0;padding-left:18px}
  .lista li{margin:2px 0}
  .pill{display:inline-block;background:var(--panel2);border:1px solid var(--border2);border-radius:6px;padding:1px 7px;margin:2px 3px 2px 0;font-size:12px;font-variant-numeric:tabular-nums}
  .board{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:12px;align-items:start}
  .board-col{background:var(--panel);border:1px solid var(--border);border-radius:10px;min-height:90px;overflow:hidden}
  .board-col h3{margin:0;padding:9px 11px;font-size:12px;letter-spacing:.4px;text-transform:uppercase;border-bottom:1px solid var(--border);background:var(--panel2)}
  .board-col .col-body{padding:9px;display:grid;gap:8px}
  .board-col .vacio{color:var(--faint);font-size:12px;font-style:italic;padding:2px 2px}
  .chip{border:1px solid var(--border);border-left:3px solid var(--faint);border-radius:7px;padding:7px 9px;background:var(--panel2)}
  .chip-id{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-weight:700}
  .chip-inst{font-size:12px;color:var(--muted);margin-top:2px}
  .chip-meta{font-size:11px;color:var(--faint);margin-top:4px}
  .chip .mini{margin-top:6px}
  .btn{background:var(--panel2);color:var(--text);border:1px solid var(--border2);border-radius:7px;padding:7px 11px;font-size:12px;font-weight:600;cursor:pointer;letter-spacing:.2px}
  .btn:hover{border-color:var(--accent);color:#fff}
  .btn-mini{padding:3px 8px;font-size:11px}
  .btn-aceptar{border-color:rgba(63,185,80,.55);color:#7ee787}
  .btn-esperar{border-color:rgba(240,160,32,.55);color:#ffd48a}
  .btn-operar{border-color:rgba(163,113,247,.55);color:#d2a8ff}
  .btn-descartar{border-color:rgba(248,81,73,.55);color:#ff9b95}
  .btn-resultado{border-color:rgba(57,197,207,.55);color:#6fd6de}
  .btn-reset{width:100%;margin-top:14px}
  .decision-card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:12px}
  .decision-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
  .decision-current{font-size:12px;color:var(--muted)}
  .decision-actions{display:flex;flex-wrap:wrap;gap:7px;align-items:center}
  select{background:var(--panel2);color:var(--text);border:1px solid var(--border2);border-radius:7px;padding:6px 8px;font-size:12px}
  .kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px;margin-top:8px}
  .kv div{background:var(--panel2);border:1px solid var(--border);border-radius:7px;padding:7px 9px;font-size:12px}
  .kv span{display:block;color:var(--faint);font-size:10px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
  .summary{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
  .summary .sum{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--muted)}
  .summary .sum b{color:var(--text)}
  footer{max-width:1400px;margin:0 auto;padding:18px 20px 40px;color:var(--faint);font-size:12px;border-top:1px solid var(--border)}
  footer p{margin:4px 0}
  .ok{color:var(--ok)} .warn{color:var(--warn)} .bad{color:var(--bad)}

  /* --- desplegable por instrumento --- */
  tr.inst-row{cursor:pointer}
  tr.inst-row:focus{outline:2px solid var(--accent);outline-offset:-2px}
  tr.inst-row:hover{background:rgba(79,140,255,.07)}
  tr.inst-row td:first-child::before{content:"\25B8  ";color:var(--accent);font-size:11px}
  tr.inst-row.open td:first-child::before{content:"\25BE  "}
  tr.detail-row{display:none}
  tr.detail-row.open{display:table-row}
  tr.detail-row > td{background:var(--panel2);padding:14px;border-bottom:1px solid var(--border)}
  .detail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:14px}
  .detail h4{margin:0 0 8px;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--border);padding-bottom:6px}
  .detail .field{margin-bottom:8px}
  .esc-mini{border:1px solid var(--border);border-left:3px solid var(--faint);border-radius:8px;padding:9px 11px;margin-bottom:8px;background:var(--panel)}
  .esc-mini .mi{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-weight:700}
  .esc-mini .ms{font-size:11px;color:var(--muted);margin:2px 0 6px}
  .esc-mini .campo{font-size:12px;margin:3px 0;line-height:1.45}
  .esc-mini .campo > b{color:var(--faint);font-weight:700;font-size:10px;text-transform:uppercase;letter-spacing:.4px;margin-right:5px}
  .hint{font-size:11px;color:var(--faint);margin:0 0 10px}

  /* --- grupos de planes --- */
  .group{margin-bottom:26px}
  .group-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;padding:10px 12px;border-radius:8px;border:1px solid var(--border);border-left:4px solid var(--faint);background:var(--panel);margin-bottom:12px}
  .group-head h3{margin:0;font-size:14px}
  .group-head .cnt{color:var(--muted);font-size:12px}
  .group-head .dsc{color:var(--faint);font-size:11px}
  .group.g-incompletos .group-head{border-left-color:var(--warn)}
  .group.g-completos .group-head{border-left-color:var(--ok)}
  .group.g-oportunidades .group-head{border-left-color:var(--purple)}
  .group.g-otras .group-head{border-left-color:var(--bad)}
  .group .vacio{color:var(--faint);font-size:12px;font-style:italic;padding:10px 12px;background:var(--panel);border:1px dashed var(--border2);border-radius:8px}
  .prov-sum{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}

  /* --- manager --- */
  .dim-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:10px;margin-bottom:12px}
  .dim{background:var(--panel2);border:1px solid var(--border);border-radius:8px;padding:9px 11px}
  .dim > label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--faint);margin-bottom:5px;font-weight:700}
  .dim .dv{font-size:13px}
  .stop-box{border:1px dashed rgba(219,109,40,.55);background:rgba(219,109,40,.08);border-radius:8px;padding:10px 12px;margin-top:10px}
  .stop-box b{color:#ffa657}
  .stop-box .field{margin-bottom:6px}
  @media (max-width:720px){
    h1{font-size:17px}
    .top-inner{padding:12px 12px 0}
    main{padding:12px}
    .tab{padding:9px 10px;font-size:12px}
  }
</style>
</head>
<body>
<header class="top">
  <div class="top-inner">
    <div class="title-row">
      <h1 id="titulo">YouTube Analyst — Dashboard</h1>
      <span class="tag tag-paper">PAPER_ONLY</span>
      <span class="tag tag-offline">Sin conexión · file://</span>
    </div>
    <p class="fuente" id="fuente"></p>
    <div class="avisos" id="avisos"></div>
    <nav class="tabs" id="tabs">
      <button class="tab active" data-tab="mercado">MERCADO</button>
      <button class="tab" data-tab="planes">PLANES</button>
      <button class="tab" data-tab="manager">MANAGER</button>
      <button class="tab" data-tab="seguimiento">SEGUIMIENTO</button>
      <button class="tab" data-tab="decision">DECISIÓN</button>
    </nav>
  </div>
</header>

<main>
