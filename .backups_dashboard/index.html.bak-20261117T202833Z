      ' · ' + temporalidades(e) + ' · vídeo ' + esc(e.timestamp_explicacion || 'NO DECLARADO') + '</div>' +
      '</div><div class="card-badges">' + badgeClasif(e.clasificacion) + badgeVeredicto(e.veredicto) +
      (e.demo ? ' <span class="badge badge-demo">DEMO</span>' : '') +
      '<span class="badge badge-estado" style="color:' + estadoMeta(st.key).color + ';border-color:' + estadoMeta(st.key).color + '" title="Estado de seguimiento">' + esc(st.key) + '</span>' +
      '</div></div>';
    html += '<div class="card-body">';
    html += procSum(e);
    html += '<div class="grid">';
    html += campo('Nivel / zona', fmtValor(e.nivel && e.nivel.valor) + ' ' + provBadge(e.nivel && e.nivel.procedencia));
    html += campo('Condición de activación', texto(e.condicion_activacion && e.condicion_activacion.valor) + ' ' + provBadge(e.condicion_activacion && e.condicion_activacion.procedencia));
    html += campo('Entrada', fmtValor(e.entrada && e.entrada.valor) + ' ' + provBadge(e.entrada && e.entrada.procedencia));
    html += campo('Stop / invalidación (escenario)', fmtValor(e.stop && e.stop.valor) + ' ' + provBadge(e.stop && e.stop.procedencia) +
      '<div class="cell-note">El escenario no declara stop; la propuesta del Manager se muestra en la pestaña MANAGER.</div>');
    html += campo('Objetivos', listaObjetos(e.objetivos, 'valor', 'NO DECLARADO'));
    html += campo('Riesgo / beneficio', fmtValor(ev.risk_reward) + ' ' + provNoDeclarada('El JSON no declara risk/reward para este escenario'));
    html += campo('Información faltante', listaTexto(e.info_faltante, 'NO DECLARADO'));
    html += campo('Evidencia', listaTexto(e.evidencia, 'FALTA INFORMACION'));
    html += campo('Justificación', texto(e.justificacion));
    html += campo('Relación de temporalidades / detalle', texto(e.relacion_temporalidades, 'NO DECLARADO'));
    html += campo('Fuente', texto(e.fuente) + ' ' + provNoDeclarada('El JSON no declara procedencia para la fuente'));
    html += campo('Temporalidad de origen', texto(e.temporalidad_origen) + ' · método de cálculo: ' + texto(e.metodo_calculo));
    html += campo('Estado de seguimiento', badgeEstado(st.key) + '<div class="cell-sub">' + marcaOrigen(st.origen) + '</div>');
    html += '</div>';
    html += '</div></article>';
    return html;
  }

  /* ---------- 2. PLANES ---------- */
  function renderPlanes() {
    var html = '';
    html += '<div class="section-head"><h2 class="section-title">Planes</h2>' +
      '<span class="section-sub">' + ESCS.length + ' escenarios del vídeo, agrupados por completitud del plan</span></div>';
    html += '<p class="section-note">Clasificación del Analyst (9 tipos del contrato). Los tres grupos visuales son los exigidos por el contrato v1.1: PLANES INCOMPLETOS, PLANES COMPLETOS y OPORTUNIDADES VALIDADAS. Un plan <b>no</b> es completo por tener solo un nivel y un posible objetivo. Los campos que faltan quedan siempre visibles.</p>';
    html += '<div class="legend">' +
      '<span><b>Procedencia (badges A/B/C/D):</b></span>' +
      '<span><span class="proc prov-A">A · EXPLÍCITO</span> dicho por CreceTrader</span>' +
      '<span><span class="proc prov-B">B · OBSERVADO</span> visible en el gráfico</span>' +
      '<span><span class="proc prov-C">C · CÁLCULO</span> del sistema</span>' +
      '<span><span class="proc prov-D">D · PROPUESTA DEL MANAGER</span> recomendación</span>' +
      '<span><span class="proc prov-none">SIN PROCEDENCIA</span> no declarada</span>' +
      '</div>';

    var counts = {};
    ESCS.forEach(function (e) { counts[e.clasificacion] = (counts[e.clasificacion] || 0) + 1; });
    html += '<div class="summary">' + Object.keys(counts).map(function (k) {
      return '<span class="sum"><span class="badge ' + clasifMeta(k).badge + '">' + esc(k) + '</span> × <b>' + counts[k] + '</b></span>';
    }).join('') + '</div>';

    GRUPOS_PLANES.forEach(function (g) {
      var items = ESCS.filter(function (e) { return grupoDe(e.clasificacion) === g.key; });
      html += '<section class="group ' + g.cls + '">';
      html += '<div class="group-head"><h3>' + esc(g.titulo) + '</h3>' +
        '<span class="cnt">' + items.length + ' escenario(s)</span>' +
        '<span class="dsc">' + esc(g.desc) + '</span></div>';
      if (!items.length) {
        html += '<div class="vacio">Sin escenarios en esta categoría en el JSON. No se inventa ninguno: el dato real no los tiene.</div>';
      } else {
        html += '<div class="cards">' + items.map(escenarioCard).join('') + '</div>';
      }
      html += '</section>';
    });

    var otras = ESCS.filter(function (e) { return grupoDe(e.clasificacion) === 'otras'; });
    if (otras.length) {
      html += '<section class="group g-otras">';
      html += '<div class="group-head"><h3>OTRAS CLASIFICACIONES</h3>' +
        '<span class="cnt">' + otras.length + ' escenario(s)</span>' +
        '<span class="dsc">' + TIPOS_OTRAS.map(esc).join(' · ') + ' (no pertenecen a los tres grupos anteriores; se muestran para no ocultarlas)</span></div>';
      html += '<div class="cards">' + otras.map(escenarioCard).join('') + '</div>';
      html += '</section>';
    }

    document.getElementById('panel-planes').innerHTML = html;
  }

  /* ---------- 3. MANAGER ---------- */
  function renderManager() {
    var html = '';
    html += '<div class="section-head"><h2 class="section-title">Manager</h2>' +
      '<span class="section-sub">Evaluación por dimensiones, veredicto, motivos, qué se necesita y propuesta de stop</span></div>';
    html += '<p class="section-note">Las cuatro dimensiones del contrato (§6) van separadas: calidad del análisis, completitud del plan, viabilidad técnica y riesgo/capital. El JSON no declara procedencia para las dimensiones, el veredicto, los motivos ni "que_se_necesita": se muestran como SIN PROCEDENCIA. La <b>propuesta de stop del Manager sí declara procedencia D</b> y se resalta. Capital simulado (§7), separado de la evaluación.</p>';
    html += '<div class="legend">' +
      '<span><b>Veredicto:</b></span>' +
      Object.keys(VEREDICTO).map(function (k) { return '<span><span class="badge ' + VEREDICTO[k].badge + '">' + k + '</span></span>'; }).join('') +
      '</div>';
    var counts = {};
    ESCS.forEach(function (e) { var v = (e.evaluacion && e.evaluacion.veredicto) || e.veredicto; counts[v] = (counts[v] || 0) + 1; });
    html += '<div class="summary">' + Object.keys(counts).map(function (k) {
      return '<span class="sum"><span class="badge ' + veredictoMeta(k).badge + '">' + esc(k) + '</span> × <b>' + counts[k] + '</b></span>';
    }).join('') + '</div>';

    html += '<div class="cards">';
    ESCS.forEach(function (e) {
      var ev = e.evaluacion || {};
      var dims = ev.dimensiones || {};
      var ry = dims.riesgo_y_capital || {};
      var cap = ev.capital || {};
      var v = ev.veredicto || e.veredicto;
      var stop = ev.propuesta_stop || null;
      var h = '<article class="card ' + clasifMeta(e.clasificacion).cls + '" data-card-id="' + esc(e.id) + '">';
      h += '<div class="card-head"><div>' +
        '<div class="card-id">' + esc(e.id || 'NO DECLARADO') + '</div>' +
        '<div class="card-sub">' + esc(e.instrumento || 'NO DECLARADO') + ' · ' + texto(e.direccion) + ' · ' + temporalidades(e) +
        ' · clasificación ' + badgeClasif(e.clasificacion) + '</div>' +
        '</div><div class="card-badges">' + badgeVeredicto(v) + (ev.paper_only ? ' <span class="badge badge-demo">PAPER_ONLY</span>' : '') + '</div></div>';
      h += '<div class="card-body">';

      h += '<div class="dim-grid">' +
        '<div class="dim"><label>1 · Calidad del análisis</label><div class="dv">' + texto(dims.calidad_analisis) + ' ' + provNoDeclarada('Dimensión del Manager (§6); el JSON no declara procedencia') + '</div></div>' +
        '<div class="dim"><label>2 · Completitud del plan</label><div class="dv">' + texto(dims.completitud_plan) + ' ' + provNoDeclarada('Dimensión del Manager (§6); el JSON no declara procedencia') + '</div></div>' +
        '<div class="dim"><label>3 · Viabilidad técnica</label><div class="dv">' + texto(dims.viabilidad_tecnica) + ' ' + provNoDeclarada('Dimensión del Manager (§6); el JSON no declara procedencia') + '</div></div>' +
        '<div class="dim"><label>4 · Riesgo y capital</label><div class="dv">' + texto(ry.veredicto) + ' ' + badgeVeredicto(ry.veredicto) +
        '<div class="cell-note">risk_reward: ' + fmtValor(ry.risk_reward) + ' ' + provNoDeclarada('El JSON no declara risk/reward') + '</div></div></div>' +
        '</div>';

      h += '<div class="grid">';
      h += campo('Veredicto del Manager', badgeVeredicto(v) + ' ' + provNoDeclarada('El JSON no declara procedencia para el veredicto'));
      h += campo('Motivos', listaTexto(ev.motivos, 'NO DECLARADO'));
      h += campo('Condiciones faltantes', listaTexto(ev.condiciones_faltantes, 'FALTA INFORMACION'));
      h += campo('Qué se necesita', listaTexto(ev.que_se_necesita, 'FALTA INFORMACION'));
      h += campo('Risk / reward (evaluación)', fmtValor(ev.risk_reward) + ' ' + provNoDeclarada('El JSON no declara risk/reward para este escenario'));
      h += campo('Decisión del usuario', texto(ev.decision_usuario, 'PENDIENTE') + ' <span class="muted small">(se registra solo en localStorage, pestaña DECISIÓN)</span>');
      h += '</div>';

      h += '<div class="stop-box"><b>Propuesta de stop del Manager</b> ';
      if (stop) {
        h += fmtNum(stop.valor) + ' ' + provBadge(stop.procedencia);
        h += '<div class="field"><label>Método</label><div class="field-val">' + texto(stop.metodo) + ' ' + provBadge(stop.procedencia) + '</div></div>';
      } else {
        h += '<span class="missing">NO DECLARADO</span> ' + provNoDeclarada('El Manager no propuso stop para este escenario');
      }
      h += '<div class="cell-note">Procedencia D = propuesta propia del Manager; no es un dato dicho por CreceTrader (A) ni un cálculo del sistema (C).</div>';
      h += '</div>';

      h += '<div class="kv">' +
        '<div><span>Capital disponible</span>' + fmtValor(cap.disponible) + ' ' + provCapital('Parámetro de entrada del sistema (capital.json, §7); no asume capital real') + '</div>' +
        '<div><span>Riesgo %</span>' + fmtValor(cap.riesgo_pct) + ' ' + provCapital('Parámetro de entrada del sistema (§7)') + '</div>' +
        '<div><span>Tamaño propuesto</span>' + fmtValor(cap.tamano_propuesto) + ' ' + provCapital('Cálculo del sistema (§7)') + '</div>' +
        '<div><span>Pérdida potencial</span>' + fmtValor(cap.perdida_potencial) + ' ' + provCapital('Cálculo del sistema (§7)') + '</div>' +
        '<div><span>Exposición máxima</span>' + fmtValor(cap.exposicion_maxima) + ' ' + provCapital('Cálculo del sistema (§7)') + '</div>' +
        '</div>';

      h += '</div></article>';
      html += h;
    });
    html += '</div>';
    document.getElementById('panel-manager').innerHTML = html;
  }

  /* ---------- 4. SEGUIMIENTO ---------- */
  function renderSeguimiento() {
    var html = '';
    html += '<div class="section-head"><h2 class="section-title">Seguimiento</h2>' +
      '<span class="section-sub">7 estados del ciclo de vida de un escenario</span></div>';
    html += '<div class="aviso aviso-rojo" style="margin-bottom:14px"><b>Tocar un nivel NO activa la operación.</b> Lo activa la condición definida en el plan. La activación solo puede registrarla el usuario manualmente (pestaña DECISIÓN, botón "Operada manual") o el sistema cuando la condición se cumple.</div>';
    html += '<div class="legend">' +
      '<span><b>Estados:</b></span>' +
      ESTADOS_ORDER.map(function (k) { return '<span><span class="badge badge-estado" style="color:' + ESTADOS[k].color + ';border-color:' + ESTADOS[k].color + '">' + k + '</span> <span class="muted">' + esc(ESTADOS[k].desc) + '</span></span>'; }).join('') +
      '</div>';
    html += '<p class="section-note">Estado inicial derivado por el sistema a partir del veredicto del Manager (<b>C · DERIVADO</b>). Si el usuario decide en la pestaña DECISIÓN, el estado mostrado es el de localStorage (<b>USUARIO</b>). Ningún estado implica ejecución real: PAPER_ONLY.</p>';

    var grupos = {};
    ESTADOS_ORDER.forEach(function (k) { grupos[k] = []; });
    var descartados = [];
    ESCS.forEach(function (e) {
      var st = effState(e);
      if (st.key === 'DESCARTADO_USUARIO') { descartados.push({ e: e, st: st }); return; }
      if (!grupos[st.key]) grupos[st.key] = [];
      grupos[st.key].push({ e: e, st: st });
    });

    html += '<div class="board">';
    ESTADOS_ORDER.forEach(function (k) {
      var items = grupos[k];
      html += '<div class="board-col"><h3 style="color:' + ESTADOS[k].color + '">' + k + ' (' + items.length + ')</h3><div class="col-body">';
      if (!items.length) { html += '<div class="vacio">sin escenarios</div>'; }
      items.forEach(function (it) {
        html += '<div class="chip" style="border-left-color:' + ESTADOS[k].color + '">' +
          '<div class="chip-id">' + esc(it.e.id || 'NO DECLARADO') + '</div>' +
          '<div class="chip-inst">' + esc(it.e.instrumento || 'NO DECLARADO') + ' · ' + texto(it.e.direccion) + '</div>' +
          '<div class="chip-meta">' + marcaOrigen(it.st.origen) + (it.st.ts ? ' · ' + esc(it.st.ts) : '') + '</div>' +
          (it.st.decision ? '<div class="chip-meta">' + esc(DECISION_LABEL[it.st.decision] || it.st.decision) + '</div>' : '') +
          (k === 'ACTIVADO' ? '<button class="btn btn-mini btn-operar" data-action="to-seguimiento" data-id="' + esc(it.e.id) + '">→ EN_SEGUIMIENTO</button>' : '') +
          '</div>';
      });
      html += '</div></div>';
    });
    html += '</div>';

    html += '<h3 style="margin:22px 0 8px;font-size:13px;letter-spacing:.4px;text-transform:uppercase;color:var(--muted)">Descartados por el usuario (' + descartados.length + ')</h3>';
    if (!descartados.length) {
      html += '<p class="muted small">Ningún escenario ha sido descartado. Los cambios se guardan solo en localStorage.</p>';
    } else {
      html += '<div class="cards">' + descartados.map(function (it) {
        return '<article class="card c-desc"><div class="card-head"><div>' +
          '<div class="card-id">' + esc(it.e.id || 'NO DECLARADO') + '</div>' +
          '<div class="card-sub">' + esc(it.e.instrumento || 'NO DECLARADO') + ' · ' + texto(it.e.direccion) + '</div>' +
          '</div><div class="card-badges"><span class="badge badge-c-desc">DESCARTADO</span></div></div>' +
          '<div class="card-body"><div class="cell-sub">' + marcaOrigen('usuario') + (it.st.ts ? ' · ' + esc(it.st.ts) : '') + '</div>' +
          '<p class="small muted" style="margin:8px 0 0">Descartado por el usuario. No es una invalidación técnica ni una operación.</p></div></article>';
      }).join('') + '</div>';
    }

    html += '<div class="summary" style="margin-top:18px">' +
      '<span class="sum">EN_OBSERVACION: <b>' + grupos.EN_OBSERVACION.length + '</b></span>' +
      '<span class="sum">ESPERANDO_ACTIVACION: <b>' + grupos.ESPERANDO_ACTIVACION.length + '</b></span>' +
      '<span class="sum">ACTIVADO: <b>' + grupos.ACTIVADO.length + '</b></span>' +
      '<span class="sum">EN_SEGUIMIENTO: <b>' + grupos.EN_SEGUIMIENTO.length + '</b></span>' +
      '<span class="sum">OBJETIVO_ALCANZADO: <b>' + grupos.OBJETIVO_ALCANZADO.length + '</b></span>' +
      '<span class="sum">INVALIDADO: <b>' + grupos.INVALIDADO.length + '</b></span>' +
      '<span class="sum">EXPIRADO: <b>' + grupos.EXPIRADO.length + '</b></span>' +
      '</div>';
    document.getElementById('panel-seguimiento').innerHTML = html;
  }

  /* ---------- 5. DECISIÓN ---------- */
  function renderDecision() {
    var html = '';
    html += '<div class="section-head"><h2 class="section-title">Decisión</h2>' +
      '<span class="section-sub">Acciones registradas por el usuario, solo en localStorage</span></div>';
    html += '<p class="section-note">Estas acciones <b>no ejecutan operaciones</b> ni envían datos a ningún servidor. Guardan una marca local en este navegador (localStorage, clave <code>' + esc(LS_KEY) + '</code>). El estado resultante se refleja en la pestaña SEGUIMIENTO. Tocar un nivel no activa nada: solo registra tu decisión.</p>';
    html += '<div class="legend">' +
      '<span><b>Botones por escenario:</b></span>' +
      '<span><span class="btn btn-mini btn-aceptar">Aceptar seguimiento</span> → EN_OBSERVACION</span>' +
      '<span><span class="btn btn-mini btn-esperar">Esperar</span> → ESPERANDO_ACTIVACION</span>' +
      '<span><span class="btn btn-mini btn-operar">Operada manual</span> → ACTIVADO</span>' +
      '<span><span class="btn btn-mini btn-resultado">Registrar resultado</span> → OBJETIVO_ALCANZADO / INVALIDADO / EXPIRADO</span>' +
      '<span><span class="btn btn-mini btn-descartar">Descartar</span> → fuera del tablero</span>' +
      '</div>';

    ESCS.forEach(function (e) {
      var d = decisions[e.id] || {};
      var st = effState(e);
      var actual = d.decision ? (DECISION_LABEL[d.decision] || d.decision) : 'SIN DECISIÓN REGISTRADA';
      html += '<div class="decision-card" data-card-id="' + esc(e.id) + '">';
      html += '<div class="decision-top"><div>' +
        '<div class="card-id">' + esc(e.id || 'NO DECLARADO') + '</div>' +
        '<div class="card-sub">' + esc(e.instrumento || 'NO DECLARADO') + ' · ' + texto(e.direccion) + ' · ' + temporalidades(e) + '</div>' +
        '</div><div class="card-badges">' + badgeClasif(e.clasificacion) + badgeVeredicto(e.veredicto) + badgeEstado(st.key) + '</div></div>';
      html += '<div class="decision-current">Decisión actual: <b>' + esc(actual) + '</b>' +
        (d.ts ? ' · ' + esc(d.ts) : '') + ' · origen: ' + (d.decision ? 'USUARIO (localStorage)' : 'derivado del veredicto (C)') + '</div>';
      html += '<div class="decision-actions">' +
        '<button class="btn btn-aceptar" data-action="aceptar" data-id="' + esc(e.id) + '">Aceptar seguimiento</button>' +
        '<button class="btn btn-esperar" data-action="esperar" data-id="' + esc(e.id) + '">Esperar</button>' +
        '<button class="btn btn-operar" data-action="operada" data-id="' + esc(e.id) + '">Operada manual</button>' +
        '<select id="resultado-' + esc(e.id) + '">' +
        '<option value="OBJETIVO_ALCANZADO">OBJETIVO_ALCANZADO</option>' +
        '<option value="INVALIDADO">INVALIDADO</option>' +
        '<option value="EXPIRADO">EXPIRADO</option>' +
        '</select>' +
        '<button class="btn btn-resultado" data-action="registrar" data-id="' + esc(e.id) + '">Registrar resultado</button>' +
        '<button class="btn btn-descartar" data-action="descartar" data-id="' + esc(e.id) + '">Descartar</button>' +
        '</div>';
      html += '</div>';
    });

    html += '<button class="btn btn-reset" data-action="reset">Restablecer todas las decisiones (borra localStorage)</button>';
    html += '<p class="small muted" style="margin-top:10px">PAPER_ONLY · sin ejecución real · sin verificación visual · ninguna alerta es una operación.</p>';
    document.getElementById('panel-decision').innerHTML = html;
  }

  /* ---------- acciones ---------- */
  function aplicarDecision(id, decision, estado, descartado, resultado) {
    var d = decisions[id] || {};
    d.decision = decision;
    d.descartado = !!descartado;
    d.estado = descartado ? null : estado;
    d.resultado = resultado || null;
    d.ts = new Date().toISOString();
    decisions[id] = d;
    saveDecisions(decisions);
    refrescarTodo();
  }
  function refrescarTodo() {
    renderMercado();
    renderPlanes();
    renderManager();
    renderSeguimiento();
    renderDecision();
  }
  function toggleInst(k) {
    abiertos[k] = !abiertos[k];
    renderMercado();
  }

  document.addEventListener('click', function (ev) {
    var t = ev.target;
    var actionEl = null, instEl = null;
    while (t && t !== document) {
      if (!actionEl && t.getAttribute && t.getAttribute('data-action')) actionEl = t;
      if (!instEl && t.getAttribute && t.getAttribute('data-inst')) instEl = t;
      if (actionEl && instEl) break;
      t = t.parentNode;
    }
    if (actionEl) {
      var action = actionEl.getAttribute('data-action');
      var id = actionEl.getAttribute('data-id');
      if (action === 'reset') {
        if (confirm('¿Borrar todas las decisiones guardadas en localStorage?')) {
          decisions = {};
          saveDecisions(decisions);
          refrescarTodo();
        }
        return;
      }
      if (!id) return;
      if (action === 'aceptar') aplicarDecision(id, 'aceptar_seguimiento', 'EN_OBSERVACION');
      else if (action === 'esperar') aplicarDecision(id, 'esperar', 'ESPERANDO_ACTIVACION');
      else if (action === 'operada') aplicarDecision(id, 'operada_manual', 'ACTIVADO');
      else if (action === 'descartar') aplicarDecision(id, 'descartado', null, true);
      else if (action === 'to-seguimiento') aplicarDecision(id, 'en_seguimiento', 'EN_SEGUIMIENTO');
      else if (action === 'registrar') {
        var sel = document.getElementById('resultado-' + id);
        var val = sel ? sel.value : null;
        if (!val) { alert('Selecciona un resultado.'); return; }
        aplicarDecision(id, 'registrar_resultado', val, false, val);
      }
      return;
    }
    if (instEl) { toggleInst(instEl.getAttribute('data-inst')); return; }
  });

  document.addEventListener('keydown', function (ev) {
    var t = ev.target;
    while (t && t !== document && !(t.getAttribute && t.getAttribute('data-inst'))) t = t.parentNode;
    if (!t || !t.getAttribute) return;
    if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); toggleInst(t.getAttribute('data-inst')); }
  });

  /* ---------- arranque ---------- */
  renderHeader();
  renderMercado();
  renderPlanes();
  renderManager();
  renderSeguimiento();
  renderDecision();
  initTabs();
})();
</script>
</body>
</html>
